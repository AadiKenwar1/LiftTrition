{
    "expo": {
        "name": "PLATES",
        "slug": "App",
        "version": "1.0.4",
        "orientation": "portrait",
        "icon": "./assets/images/PlatesAppIcon.png",
        "scheme": "app",
        "userInterfaceStyle": "automatic",
        "newArchEnabled": true,
        "runtimeVersion": {
            "policy": "fingerprint"
        },
        "updates": {
            "url": "https://u.expo.dev/22572fc8-eb07-4d16-90bc-8ebd90b2a812"
        },
        "ios": {
            "supportsTablet": false,
            "bundleIdentifier": "com.LiftTrition.App",
            "usesAppleSignIn": true,
            "infoPlist": {
                "ITSAppUsesNonExemptEncryption": false
            }
        },
        "android": {
            "adaptiveIcon": {
                "foregroundImage": "./assets/images/adaptive-icon.png",
                "backgroundColor": "#ffffff"
            },
            "edgeToEdgeEnabled": true,
            "predictiveBackGestureEnabled": false
        },
        "web": {
            "bundler": "metro",
            "output": "static",
            "favicon": "./assets/images/favicon.png"
        },
        "plugins": [
            "expo-router",
            "@react-native-community/datetimepicker",
            "expo-apple-authentication",
            "@journeyapps/react-native-quick-sqlite",
            "expo-font",
            "expo-notifications",
            [
                "expo-splash-screen",
                {
                    "image": "./assets/images/LogoWhite.png",
                    "imageWidth": 200,
                    "resizeMode": "contain",
                    "backgroundColor": "#FFFFFF",
                    "dark": {
                        "image": "./assets/images/LogoBlack.png",
                        "backgroundColor": "#121212"
                    }
                }
            ],
            [
                "expo-image-picker",
                {
                    "photosPermission": "Allow PLATES to access your photos to log meals from your library.",
                    "microphonePermission": false
                }
            ],
            [
                "@sentry/react-native/expo",
                {
                    "url": "https://sentry.io/",
                    "project": "lifttritionapp",
                    "organization": "na-mvc"
                }
            ]
        ],
        "experiments": {
            "typedRoutes": true
        },
        "extra": {
            "router": {},
            "eas": {
                "projectId": "22572fc8-eb07-4d16-90bc-8ebd90b2a812"
            }
        }
    }
}
